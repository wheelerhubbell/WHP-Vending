{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corrections Course Case",
  "type": "object",
  "required": ["case_id","course","domain","source_object","assistant_response","task"],
  "properties": {
    "case_id": {"type":"string"},
    "course": {"enum":["RECEIVE","LOCATE","RESTORE","BOUND","PROPAGATE","RETAIN","TRANSFER","RESIST","ANTICIPATE"]},
    "domain": {"type":"string"},
    "source_object": {"type":"string"},
    "assistant_response": {"type":"string"},
    "correction": {"type":["string","null"]},
    "task": {"type":"string"}
  }
}
